GDL_DB_SERVER=localhost
GDL_DB_PORT=1433
GDL_DB_NAME=ArcadeIQ
GDL_DB_USER=ArcadeIQApp
GDL_DB_PASSWORD=change-me
GDL_DB_ENCRYPT=false
GDL_DB_TRUST_CERT=true

GDL_SA_PASSWORD=change-this-strong-sa-password

GDL_POSTGRES_DB=gdl
GDL_POSTGRES_USER=gdl
GDL_POSTGRES_PASSWORD=gdl_dev_password
GDL_DATABASE_URL=postgresql+psycopg://gdl:gdl_dev_password@localhost:5432/gdl
GDL_CORS_ORIGINS=http://localhost:5173

GDL_ADMIN_USER_ID=local-admin
GDL_ADMIN_EMAIL=admin@game-discovery-lens.local
GDL_ADMIN_DISPLAY_NAME=Local Admin
GDL_ADMIN_PASSWORD=change-this-local-admin-password
GDL_AUTH_SECRET=local-only-change-this-auth-secret
GDL_AUTH_TOKEN_TTL_SECONDS=43200

# Optional backend-only AI provider; the default uses local rules.
GDL_AI_ENABLED=false
GDL_AI_PROVIDER=rules
GDL_AI_FALLBACK_TO_RULES=true
GDL_AI_TIMEOUT_SECONDS=8
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Frontend configuration belongs in frontend/.env.local.
# Copy frontend/.env.example separately; Vite does not load this root file.
